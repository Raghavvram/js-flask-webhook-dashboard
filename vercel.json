
{
  "version": 2,
  "builds": [
    {
      "src": "/frontend/next.config.mjs",
      "use": "@vercel/next"
    },
    {
      "src": "/backend/app.py",
      "use": "@vercel/python"
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/backend/app.py"
    },
    {
      "source": "/(.*)",
      "destination": "/frontend/$1"
    }
  ]
}
